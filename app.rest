###
# ========================================
# FLUXO: ABERTURA DE CONTA BANCÁRIA
# ========================================

###
# PASSO 1: Requisitar abertura de conta bancária
# - O request_id é gerado automaticamente ({{$guid}})
# - Retorna os dados da solicitação com status "in_progress"
# - Copie o "id" retornado para usar no próximo passo
POST http://localhost:4000/api/bank_account/open
content-type: application/json

{
    "request_id": "{{$guid}}",
    "account_number": "ACC-03240",
    "initial_balance": 1000,
    "status": "active"
}

###
# PASSO 2: Consultar status da solicitação de abertura
# - Use o request_id (id) retornado no passo anterior
# - Permite fazer polling para verificar o status da solicitação
# - Se houver erro, o campo "error" conterá a mensagem de erro
# - Se sucesso, o campo "request_status" será "completed"
GET http://localhost:4000/api/bank_account_opening_request/86990fc4-567d-4237-9c71-d5b24d9b498e

###
# PASSO 3 (OPCIONAL): Testar idempotência
# - Execute novamente o mesmo request_id do PASSO 1
# - Deve retornar erro: "bank_account_opening_already_requested"
POST http://localhost:4000/api/bank_account/open
content-type: application/json

{
    "request_id": "1c2715ba-b451-4443-9b04-00a89be8577e",
    "account_number": "ACC-001",
    "initial_balance": 1000,
    "status": "active"
}

###
# PASSO 4 (OPCIONAL): Testar fluxo de erro - número de conta duplicado
# - Execute duas vezes com números de conta diferentes
# - Na segunda requisição, use um número de conta que já existe
# - Consulte o status para verificar o campo "error" com a mensagem customizada
POST http://localhost:4000/api/bank_account/open
content-type: application/json

{
    "request_id": "{{$guid}}",
    "account_number": "ACC-001",
    "initial_balance": 500,
    "status": "active"
}

